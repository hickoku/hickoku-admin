# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — your secrets never get committed.
# ─────────────────────────────────────────────────────────────

# --- Environment -----------------------------------------------------------
# Which data the admin works on (same switch as the storefront):
#   stage → orders-stage + site-settings-stage tables, *_STAGE keys below
#   prod  → orders + site-settings tables, *_PROD keys (or the plain names)
# If unset: `next dev` = stage, production build = prod.
APP_ENV=stage

# --- Admin panel login -----------------------------------------------------
# The password you'll type on the /login screen.
ADMIN_PASSWORD=Hickoku123

# Optional: separate secret used to sign the login session cookie.
# If left blank, ADMIN_PASSWORD is reused for this — fine for a single-admin
# setup, but set your own random string here for extra safety.
ADMIN_SESSION_SECRET=

# --- AWS (DynamoDB orders/products + S3 hero images) -----------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PRODUCTS_TABLE_NAME is no longer read: products / products-stage follow APP_ENV

# S3 bucket used to store the homepage hero image(s). See README.md
# "Setting up S3 for hero images" for step-by-step bucket setup.
S3_BUCKET_NAME=

# Optional: only needed if you serve the bucket through a custom domain /
# CloudFront distribution instead of the default *.s3.amazonaws.com URL.
S3_PUBLIC_BASE_URL=

# --- Invoice (seller identity shown on every generated invoice) ------------
# These are only the starting values. Once you save Settings → Store details
# in the admin, invoices use those instead (stored in site-settings[-stage]).
# This is the LEGAL entity name — shown instead of any storefront brand name.
SELLER_NAME=
SELLER_GSTIN=
SELLER_PAN=
SELLER_ADDRESS=
SELLER_CITY=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_PIN=
SELLER_PHONE=
SELLER_EMAIL=
SELLER_WEBSITE=
# Optional — only shown on the invoice if set.
SELLER_BANK_NAME=
SELLER_ACCOUNT_NO=
SELLER_IFSC=
SELLER_TERMS=All sales are final. Goods once sold will not be taken back or exchanged.
INVOICE_PREFIX=INV

# --- Razorpay (payment info shown on each order) ----------------------------
# Stage uses Razorpay test keys; prod uses live keys (RAZORPAY_KEY_ID_PROD,
# or the plain RAZORPAY_KEY_ID for older setups).
RAZORPAY_KEY_ID_STAGE=
RAZORPAY_KEY_SECRET_STAGE=
RAZORPAY_KEY_ID_PROD=
RAZORPAY_KEY_SECRET_PROD=

# --- Delhivery (delivery/shipment status shown on each order) --------------
# Stage must point at Delhivery's staging server so tests never book real pickups.
DELHIVERY_API_TOKEN_STAGE=
DELHIVERY_BASE_URL_STAGE=https://staging-express.delhivery.com
DELHIVERY_API_TOKEN_PROD=
DELHIVERY_BASE_URL_PROD=https://track.delhivery.com

# --- Delhivery order creation (used by /orders/create to book a real pickup
# for Amazon / influencer / other non-storefront orders) -------------------
# The pickup location name exactly as registered in your Delhivery account.
DELHIVERY_WAREHOUSE_NAME=

# Return/seller address Delhivery ships back to if a package is undelivered.
# Kept separate from SELLER_* (GST/invoice) fields since the warehouse
# address and the legal billing address can differ.
DELHIVERY_RETURN_NAME=
DELHIVERY_RETURN_ADD=
DELHIVERY_RETURN_CITY=
DELHIVERY_RETURN_STATE=
DELHIVERY_RETURN_PIN=
DELHIVERY_RETURN_PHONE=

# ─── Offer types (Buy X get Y, free gift, free delivery, codes, limits) ──────
# Leave unset until the storefront release that applies these offers is live in
# that environment. While unset, such offers can be saved but not switched on.
# Set to true on the admin after deploying the storefront update there.
OFFER_TYPES_LIVE_STAGE=
OFFER_TYPES_LIVE_PROD=
